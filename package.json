{
  "name": "@developer-overheid-nl/oas-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "oas-generator": "bin/cli.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "dev": "vite --open",
    "build": "tsc -b && vite build",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=bin/cli.js",
    "prepare": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=bin/cli.js",
    "generate": "tsx src/cli.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@stoplight/better-ajv-errors": "^1.0.3",
    "@uiw/react-codemirror": "^4.25.11",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "case-anything": "^3.1.2",
    "clsx": "^2.1.1",
    "js-yaml": "^5.2.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.15",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "postcss": "^8.5.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.6",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.9.1"
}
